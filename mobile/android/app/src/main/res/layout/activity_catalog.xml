<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/catalog_user"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_weight="1"
            android:textStyle="bold" />

        <Button
        android:textAllCaps="false"
            android:id="@+id/catalog_cart_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="Carrito" />

        <Button
        android:textAllCaps="false"
            android:id="@+id/catalog_logout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/logout"
            android:text="@string/logout" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/catalog_search"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:contentDescription="@string/search_hint"
            android:hint="@string/search_hint"
            android:inputType="text" />

        <Button
        android:textAllCaps="false"
            android:id="@+id/catalog_search_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/search"
            android:text="@string/search" />
    </LinearLayout>

    <TextView
        android:id="@+id/catalog_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="4dp" />

    <ListView
        android:id="@+id/catalog_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
